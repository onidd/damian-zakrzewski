---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: "RNAbridge",
    institution: "Poznań University of Technology",
    supervisors: "Prof. M. Antczak, Prof. T. Żok",
    description:
      "Developed and maintain the RNAbridge platform for analysing extended non-canonical RNA elements. The associated manuscript, “RNAbridge: a database of extended non-canonical helices,” has been accepted for publication in the Journal of Molecular Biology.",
    link: "https://rnabridge.cs.put.poznan.pl",
    linkText: "rnabridge.cs.put.poznan.pl",
    status: "Accepted in JMB",
    statusClass: "bg-emerald-50 text-emerald-700 ring-emerald-600/20",
  },
  {
    title: "Photocatalytic Hydrogen Production with MOFs",
    institution: "Adam Mickiewicz University",
    supervisors: "Prof. J. Gościańska",
    dates: "8 July–4 August 2026",
    description:
      "Synthesised TMU-16 and TMU-16-NH₂ metal–organic frameworks and carried out post-synthetic cobalt and nickel modifications. Evaluated the materials for photocatalytic hydrogen production, analysed gas samples using GC-TCD, and processed experimental data in Python.",
    link: "",
    linkText: "",
    status: "Completed",
    statusClass: "bg-slate-100 text-slate-600 ring-slate-500/20",
  },
  {
    title: "Pharmaceutical Toxicity in Model Bacteria",
    institution: "Poznań University of Technology",
    supervisors: "Dr. Adam Grzywaczyk",
    description:
      "Working on the manuscript “Comparative toxicity of cyclophosphamide, fluorouracil and methotrexate toward model Gram-negative bacteria,” under the supervision of Dr. Adam Grzywaczyk.",
    link: "",
    linkText: "",
    status: "In progress",
    statusClass: "bg-amber-50 text-amber-700 ring-amber-600/20",
    },
    {
    title: "Machine Learning for RNA Structure Prediction",
    institution: "Poznań University of Technology",
    supervisors: "Prof. M. Antczak, Prof. T. Żok",
    description:
      "Exploring the use of the RNAbridge dataset in machine-learning approaches to RNA structure prediction.",
    link: "",
    linkText: "",
    status: "In progress",
    statusClass: "bg-amber-50 text-amber-700 ring-amber-600/20",
  },
];
---

<Layout title="Research Projects | Damian Zakrzewski">
  <main class="mt-4">
    <h1 class="font-['Cormorant_Garamond'] italic text-4xl sm:text-5xl text-slate-900 mb-12 tracking-wide leading-tight">
      Research Projects
    </h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {projects.map((project) => (
        <article class="bg-white border border-slate-900/5 p-7 rounded-lg shadow-sm hover:border-slate-900/10 hover:shadow-lg transition-all duration-300 flex flex-col">
          <div class="flex items-start justify-between gap-4 mb-2">
            <h2 class="font-['Cormorant_Garamond'] italic text-2xl text-slate-950 leading-snug">
              {project.title}
            </h2>

            <span class={`shrink-0 rounded-full px-2.5 py-1 text-[9px] uppercase tracking-wider font-bold ring-1 ring-inset ${project.statusClass}`}>
              {project.status}
            </span>
          </div>

          <div class="text-[11px] uppercase tracking-widest font-bold text-slate-400 mb-5 space-y-0.5">
            <p>{project.institution}</p>
            <p>Supervisors: {project.supervisors}</p>
            {project.dates && <p>{project.dates}</p>}
          </div>

          <p class="text-slate-600 text-sm leading-relaxed mb-6 flex-grow">
            {project.description}
          </p>

          {project.link && (
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-900 text-xs font-semibold underline decoration-slate-200 underline-offset-4 hover:decoration-slate-900 transition-colors inline-flex items-center gap-1.5 mt-auto"
            >
              {project.linkText}
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M15 3h6v6" />
                <path d="M10 14 21 3" />
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              </svg>
            </a>
          )}
        </article>
      ))}
    </div>
  </main>
</Layout>
